{
  "name": "conver",
  "version": "1.0.0",
  "description": "Free, open-source floating Clear Glass Drop Wheel (Shift+Z): instant file conversion, compression, photo edit, PDF tools, metadata privacy, QR, and redaction.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "dev.conver.desktop",
    "productName": "Conver",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Conver-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Conver-Portable.exe"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "appImage": {
      "artifactName": "Conver.AppImage"
    },
    "deb": {
      "artifactName": "Conver.deb"
    }
  },
  "license": "MIT",
  "dependencies": {
    "electron": "^44.9.0",
    "exifr": "^7.1.3",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  }
}
